{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/01-website-mirror/site/assets/favicon-jac.png"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "traslados.jactourspuntacana.com"
        }
      ],
      "destination": "/01-website-mirror/site/traslados.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "panel.jactourspuntacana.com"
        }
      ],
      "destination": "/02-sistema-reservas/panelweb/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "panel.jactourspuntacana.com"
        }
      ],
      "destination": "/02-sistema-reservas/panelweb/:path*"
    },
    {
      "source": "/panelweb/:path*",
      "destination": "/02-sistema-reservas/panelweb/:path*"
    },
    {
      "source": "/servicios/**",
      "destination": "/servicios/:splat.html"
    },
    {
      "source": "/traslados.html",
      "destination": "/01-website-mirror/site/traslados.html"
    },
    {
      "source": "/traslados",
      "destination": "/01-website-mirror/site/traslados.html"
    },
    {
      "source": "/traslados/",
      "destination": "/01-website-mirror/site/traslados.html"
    },
    {
      "source": "/en/:path*",
      "destination": "/01-website-mirror/site/en/:path*"
    },
    {
      "source": "/",
      "destination": "/01-website-mirror/site/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/01-website-mirror/site/:path*.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/:path*.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "panel.jactourspuntacana.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "panel.jactourspuntacana.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
