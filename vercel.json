{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/01-website-mirror/site/assets/favicon-jac.png"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "panel.jactourspuntacana.com"
        }
      ],
      "destination": "/02-sistema-reservas/panelweb/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "panel.jactourspuntacana.com"
        }
      ],
      "destination": "/02-sistema-reservas/panelweb/:path*"
    },
    {
      "source": "/panelweb",
      "destination": "/02-sistema-reservas/panelweb/index.html"
    },
    {
      "source": "/panelweb/:path*",
      "destination": "/02-sistema-reservas/panelweb/:path*"
    },
    {
      "source": "/excursiones-premium",
      "destination": "/01-website-mirror/site/excursiones-premium.html"
    },
    {
      "source": "/excursiones-list",
      "destination": "/01-website-mirror/site/excursiones-list.html"
    },
    {
      "source": "/traslados",
      "destination": "/01-website-mirror/site/traslados.html"
    },
    {
      "source": "/traslados.html",
      "destination": "/01-website-mirror/site/traslados.html"
    },
    {
      "source": "/servicios/:path+",
      "destination": "/servicios/:path.html"
    },
    {
      "source": "/en/:path*",
      "destination": "/01-website-mirror/site/en/:path*.html"
    },
    {
      "source": "/",
      "destination": "/01-website-mirror/site/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/01-website-mirror/site/:path*.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "panel.jactourspuntacana.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "panel.jactourspuntacana.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/panelweb",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/panelweb/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
