{
  "version": 2,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/panelweb",
      "destination": "https://panel.jactourspuntacana.com/",
      "permanent": true
    },
    {
      "source": "/panelweb/:path*",
      "destination": "https://panel.jactourspuntacana.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "panel.jactourspuntacana.com"
        }
      ],
      "destination": "/02-sistema-reservas/panelweb/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "panel.jactourspuntacana.com"
        }
      ],
      "destination": "/02-sistema-reservas/panelweb/:path*"
    },
    {
      "source": "/",
      "destination": "/01-website-mirror/site/index.html"
    },
    {
      "source": "/panelweb",
      "destination": "/02-sistema-reservas/panelweb/index.html"
    },
    {
      "source": "/panelweb/:path*",
      "destination": "/02-sistema-reservas/panelweb/:path*"
    },
    {
      "source": "/en",
      "destination": "/01-website-mirror/site/en/index.html"
    },
    {
      "source": "/framerusercontent.com/:path*",
      "destination": "/01-website-mirror/external/framerusercontent.com/:path*"
    },
    {
      "source": "/connect.facebook.net/:path*",
      "destination": "/01-website-mirror/external/connect.facebook.net/:path*"
    },
    {
      "source": "/en/:path*",
      "destination": "/01-website-mirror/site/en/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/01-website-mirror/site/:path*"
    }
  ],
  "headers": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "panel.jactourspuntacana.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "panel.jactourspuntacana.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/panelweb",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/panelweb/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
