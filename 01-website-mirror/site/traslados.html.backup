<!DOCTYPE html>
<!-- CACHE CLEAR: 2026-09-01 -->
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reserva de Traslados | JAC Tours & Transfer</title>
  <meta name="description" content="Reserva tu traslado con mapa interactivo. Selecciona tu ubicación en el mapa o escribe la dirección." />
  <link rel="icon" href="./assets/favicon-jac.svg" type="image/svg+xml" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
  <style>
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes slideInLeft {
      from { opacity: 0; transform: translateX(-30px); }
      to { opacity: 1; transform: translateX(0); }
    }

    @keyframes slideInRight {
      from { opacity: 0; transform: translateX(30px); }
      to { opacity: 1; transform: translateX(0); }
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
      min-height: 100vh;
      padding: 0;
      color: #2c2c2c;
      font-size: 14px;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 20px 20px;
    }

    header {
      text-align: center;
      margin-bottom: 30px;
      animation: slideDown 0.6s ease;
      background: linear-gradient(135deg, #161e34 0%, #0d1520 100%);
      padding: 20px 20px 20px;
      margin: -40px -20px 30px -20px;
    }

    .header-top {
      margin-bottom: 12px;
    }

    .header-logo {
      height: 35px;
      width: auto;
      filter: brightness(1.1);
    }

    header h1 {
      font-size: 32px;
      font-weight: 800;
      color: white;
      margin-bottom: 6px;
      letter-spacing: -0.5px;
    }

    header p {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.8);
      font-weight: 300;
    }

    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      align-items: stretch;
      margin-bottom: 20px;
    }

    .map-section {
      animation: slideInLeft 0.7s ease;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
    }

    .map-container {
      height: 480px;
      border-radius: 16px;
      overflow: hidden;
    }

    #map {
      width: 100%;
      height: 100%;
    }

    .form-section-card {
      animation: slideInRight 0.7s ease;
      background: white;
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .form-section {
      margin-bottom: 20px;
      animation: fadeIn 0.8s ease;
    }

    .form-section:last-of-type {
      margin-bottom: 0;
    }

    .form-section h2 {
      font-size: 15px;
      font-weight: 700;
      color: #f27d2e;
      margin-bottom: 16px;
      text-transform: uppercase;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .form-group {
      margin-bottom: 12px;
    }

    .form-group:last-child {
      margin-bottom: 0;
    }

    label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      color: #555;
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    input,
    select {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      font-size: 13px;
      font-family: inherit;
      font-weight: 500;
      transition: all 0.3s ease;
      background: #fafafa;
    }

    input:focus,
    select:focus {
      outline: none;
      background: white;
      border-color: #f27d2e;
      box-shadow: 0 0 0 4px rgba(242, 125, 46, 0.08);
    }

    .input-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 12px;
      align-items: end;
    }

    .btn-location {
      padding: 12px 18px;
      background: linear-gradient(135deg, #f27d2e 0%, #d96b25 100%);
      color: white;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.3s ease;
      white-space: nowrap;
      height: fit-content;
      box-shadow: 0 4px 15px rgba(242, 125, 46, 0.25);
    }

    .btn-location:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(242, 125, 46, 0.35);
    }

    .btn-location:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .map-mode-toggle {
      background: linear-gradient(135deg, #f0f0f0 0%, #fafafa 100%);
      padding: 14px;
      border-radius: 8px;
      margin-bottom: 16px;
      font-size: 13px;
      text-align: center;
      border: 1px solid #e0e0e0;
    }

    .map-mode-toggle label {
      display: inline-flex;
      gap: 8px;
      margin-bottom: 0;
      font-weight: 600;
      align-items: center;
      cursor: pointer;
    }

    .map-mode-toggle select {
      width: auto;
      padding: 6px 12px;
      font-size: 13px;
      background: white;
    }

    .map-hint {
      color: #f27d2e;
      font-weight: 600;
      margin-top: 8px;
      font-size: 12px;
      animation: slideDown 0.4s ease;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .form-grid.full {
      grid-template-columns: 1fr;
    }

    #vehicleOptions {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      margin: 16px 0;
    }

    .vehicle-card {
      padding: 12px;
      border: 2px solid #e0e0e0;
      border-radius: 10px;
      background: white;
      cursor: pointer;
      transition: all 0.3s ease;
      text-align: left;
      position: relative;
      overflow: hidden;
    }

    .vehicle-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, #f27d2e 0%, transparent 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.3s ease;
    }

    .vehicle-card:hover {
      border-color: #f27d2e;
      box-shadow: 0 8px 20px rgba(242, 125, 46, 0.15);
      transform: translateY(-2px);
    }

    .vehicle-card:hover::before {
      transform: scaleX(1);
    }

    .vehicle-card.selected {
      border-color: #f27d2e;
      background: linear-gradient(135deg, rgba(242, 125, 46, 0.05) 0%, rgba(242, 125, 46, 0.02) 100%);
      box-shadow: 0 8px 25px rgba(242, 125, 46, 0.2);
    }

    .vehicle-card.selected::before {
      transform: scaleX(1);
    }

    .vehicle-card h4 {
      font-size: 14px;
      font-weight: 700;
      color: #2c2c2c;
      margin-bottom: 6px;
    }

    .vehicle-price {
      font-size: 18px;
      font-weight: 800;
      background: linear-gradient(135deg, #f27d2e 0%, #d96b25 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 4px;
    }

    .vehicle-card small {
      font-size: 11px;
      color: #999;
      line-height: 1.5;
      display: block;
    }

    .no-vehicles {
      text-align: center;
      padding: 32px;
      color: #999;
      font-size: 14px;
      grid-column: 1 / -1;
    }

    .summary-box {
      background: linear-gradient(135deg, #f9f7f5 0%, #fafafa 100%);
      border: 1px solid #e0e0e0;
      border-left: 4px solid #f27d2e;
      padding: 16px;
      border-radius: 10px;
      margin-top: 16px;
    }

    .summary-item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
      font-size: 13px;
      font-weight: 500;
      color: #555;
    }

    .summary-item:last-child {
      margin-bottom: 0;
      border-top: 2px solid #e0e0e0;
      padding-top: 12px;
      font-weight: 700;
      font-size: 16px;
      color: #2c2c2c;
      background: linear-gradient(135deg, transparent 0%, rgba(242, 125, 46, 0.03) 100%);
      padding: 12px;
      margin: 0 -20px -20px;
      border-radius: 0 0 10px 10px;
    }

    .btn-checkout {
      width: 100%;
      padding: 12px;
      background: linear-gradient(135deg, #f27d2e 0%, #d96b25 100%);
      color: white;
      border: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-top: 16px;
      box-shadow: 0 4px 15px rgba(242, 125, 46, 0.25);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .btn-checkout:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(242, 125, 46, 0.35);
    }

    .btn-checkout:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    .whatsapp-btn {
      position: fixed;
      bottom: 20px;
      right: 20px;
      width: 50px;
      height: 50px;
      background: #25D366;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);
      text-decoration: none;
      transition: all 0.3s ease;
      z-index: 999;
    }

    .whatsapp-btn:hover {
      transform: scale(1.1);
      box-shadow: 0 6px 16px rgba(37, 211, 102, 0.5);
    }

    .whatsapp-btn svg {
      width: 24px;
      height: 24px;
    }

    .info-box {
      background: linear-gradient(135deg, #e8f4f8 0%, #f0f9fb 100%);
      border-left: 4px solid #53d2dc;
      padding: 14px;
      border-radius: 8px;
      font-size: 13px;
      color: #0a5c7a;
      margin-bottom: 24px;
      font-weight: 500;
    }

    .info-box strong {
      color: #0a5c7a;
      font-weight: 700;
    }

    .autocomplete-suggestions {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: white;
      border: 1px solid #e0e0e0;
      border-top: none;
      border-radius: 0 0 8px 8px;
      list-style: none;
      margin-top: 0;
      max-height: 220px;
      overflow-y: auto;
      z-index: 100;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    .autocomplete-suggestions li {
      padding: 12px 14px;
      cursor: pointer;
      border-bottom: 1px solid #f0f0f0;
      font-size: 13px;
      color: #555;
      transition: all 0.2s ease;
      font-weight: 500;
    }

    .autocomplete-suggestions li:last-child {
      border-bottom: none;
    }

    .autocomplete-suggestions li:hover {
      background: linear-gradient(135deg, #f9f7f5 0%, #fafafa 100%);
      color: #f27d2e;
      padding-left: 18px;
    }

    .autocomplete-suggestions li.no-results {
      color: #999;
      cursor: default;
      text-align: center;
      font-style: italic;
    }

    .form-group {
      position: relative;
    }

    @media (max-width: 1024px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .map-container {
        height: 400px;
      }

      header h1 {
        font-size: 36px;
      }

      #vehicleOptions {
        grid-template-columns: repeat(2, 1fr);
      }

      .form-section-card {
        padding: 30px;
      }
    }

    @media (max-width: 640px) {
      body {
        padding: 20px 16px;
      }

      .form-section-card {
        padding: 20px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .map-container {
        height: 300px;
      }

      header h1 {
        font-size: 28px;
      }

      header p {
        font-size: 15px;
      }

      #vehicleOptions {
        grid-template-columns: 1fr;
      }

      .input-row {
        grid-template-columns: 1fr;
      }

      .btn-location {
        width: 100%;
      }

      .hero {
        gap: 20px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="header-top">
        <img src="./assets/logo-3.png" alt="JAC Tours" class="header-logo" />
      </div>
      <h1>Reserva tu Traslado</h1>
      <p>Puntacana · Transporte Seguro y Confiable · v2.0</p>
    </header>

    <div class="hero">
      <!-- Mapa -->
      <div class="map-section">
        <div class="map-container">
          <div id="map"></div>
        </div>
      </div>

      <!-- Formulario -->
      <div class="form-section-card">
        <form id="trasladosForm">
          <div>
            <div class="info-box">
              <strong>ℹ️ Cómo funciona:</strong> Escribe la dirección, clickea en el mapa o usa tu ubicación actual. Primeros 15km incluidos en el precio base.
            </div>

            <!-- Ubicación -->
            <div class="form-section">
              <h2>📍 Ubicación</h2>

              <div class="map-mode-toggle">
                <label>
                  Modo mapa:
                  <select id="mapMode">
                    <option value="pickup">Seleccionar SALIDA</option>
                    <option value="destination">Seleccionar DESTINO</option>
                  </select>
                </label>
                <div id="mapModeLabel" class="map-hint">
                  📍 Clickea en el mapa para seleccionar SALIDA
                </div>
              </div>

              <div class="form-group">
                <label>Punto de Salida</label>
                <div class="input-row">
                  <input
                    type="text"
                    id="pickupInput"
                    placeholder="Tu ubicación actual"
                    autocomplete="off"
                  />
                  <button type="button" id="getCurrentLocationBtn" class="btn-location">
                    📍 Detectar
                  </button>
                </div>
              </div>

              <div class="form-group">
                <label>Destino</label>
                <input
                  type="text"
                  id="destinationInput"
                  placeholder="A dónde vas?"
                  autocomplete="off"
                />
              </div>

              <input type="hidden" id="gpsCoordinates" />
            </div>

            <!-- Distancia y Pasajeros -->
            <div class="form-section">
              <h2>👥 Detalles</h2>

              <div class="form-grid">
                <div class="form-group">
                  <label>Distancia (KM)</label>
                  <input type="number" id="distance" min="0" step="0.1" placeholder="Auto" />
                </div>
                <div class="form-group">
                  <label>Pasajeros</label>
                  <input type="number" id="passengers" min="1" max="49" value="1" />
                </div>
              </div>
            </div>

            <!-- Vehículos -->
            <div class="form-section">
              <h2>🚗 Vehículos</h2>
              <div id="vehicleOptions"></div>
              <input type="hidden" id="selectedVehicle" />
              <input type="hidden" id="transportPrice" />
            </div>
          </div>

          <!-- Resumen -->
          <div>
            <div class="summary-box">
              <div class="summary-item">
                <span>Vehículo:</span>
                <span id="summaryVehicle">-</span>
              </div>
              <div class="summary-item">
                <span>Distancia:</span>
                <span id="summaryDistance">-</span>
              </div>
              <div class="summary-item">
                <span>Pasajeros:</span>
                <span id="summaryPassengers">-</span>
              </div>
              <div class="summary-item">
                <span>Total a Pagar:</span>
                <span id="summaryPrice">$0.00</span>
              </div>
            </div>

            <button type="submit" class="btn-checkout" id="checkoutBtn" disabled>
              Proceder al Pago
            </button>

            <a href="https://wa.me/1234567890" class="whatsapp-btn" target="_blank" rel="noopener">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.272-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-9.746 9.798c0 2.718.738 5.33 2.139 7.592l-2.26 6.541 6.753-2.212c2.176 1.185 4.602 1.812 7.06 1.812 5.376 0 9.797-4.41 9.798-9.797 0-2.616-.505-5.071-1.504-7.378-1-2.306-2.44-4.366-4.195-6.002-1.756-1.637-3.816-2.927-6.06-3.636-2.245-.71-4.65-.732-6.983-.065z"/>
              </svg>
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Leaflet Map Library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>

  <!-- Traslados Calculator (Leaflet version) -->
  <script src="./assets/traslados-calculator-leaflet.js"></script>

  <!-- Main Logic -->
  <script>
    function updateUI() {
      if (!window.trasladosCalc) return;

      const data = window.trasladosCalc.getSelectedData();
      const vehicle = data.vehicleName || '-';
      const distance = data.distance ? data.distance.toFixed(1) + ' km' : '-';
      const passengers = data.passengers + (data.passengers === 1 ? ' persona' : ' personas');
      const price = data.price || 0;

      document.getElementById('summaryVehicle').textContent = vehicle;
      document.getElementById('summaryDistance').textContent = distance;
      document.getElementById('summaryPassengers').textContent = passengers;
      document.getElementById('summaryPrice').textContent = '$' + price.toFixed(2);

      const checkoutBtn = document.getElementById('checkoutBtn');
      checkoutBtn.disabled = !data.vehicle || !data.pickup || !data.destination;
    }

    setInterval(updateUI, 300);

    document.getElementById('trasladosForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!window.trasladosCalc) {
        alert('Calculador no inicializado');
        return;
      }

      const data = window.trasladosCalc.getSelectedData();

      if (!data.vehicle || !data.pickup || !data.destination) {
        alert('Por favor completa todos los campos requeridos');
        return;
      }

      const booking = {
        type: 'traslado',
        vehicle: data.vehicle,
        vehicleName: data.vehicleName,
        distance: data.distance,
        passengers: data.passengers,
        price: data.price,
        pickup: data.pickup,
        pickupLat: data.pickupLat,
        pickupLng: data.pickupLng,
        destination: data.destination,
        destinationLat: data.destinationLat,
        destinationLng: data.destinationLng,
      };

      localStorage.setItem('jacBookingDraft', JSON.stringify(booking));
      console.log('✅ Booking guardado:', booking);

      window.location.href = './checkout.html?prefill=1&type=traslado';
    });
  </script>
</body>
</html>
