{
  "version": 2,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/signals/:path*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/e.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/n.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/n-2.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/o.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/t.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/t-2.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/servicios/isla-saona-cl%C3%A1sica",
      "destination": "/servicios/isla-saona-clasica.html",
      "permanent": true
    },
    {
      "source": "/en/servicios/isla-saona-cl%C3%A1sica",
      "destination": "/en/servicios/isla-saona-clasica.html",
      "permanent": true
    },
    {
      "source": "/servicios/isla-saona-clÃ¡sica.html",
      "destination": "/servicios/isla-saona-clasica.html",
      "permanent": true
    },
    {
      "source": "/en/servicios/isla-saona-clÃ¡sica.html",
      "destination": "/en/servicios/isla-saona-clasica.html",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/favicon.ico",
      "dest": "/assets/logo-3.png"
    },
    {
      "src": "/traslados/?$",
      "dest": "/traslados.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/servicios/traslados/?$",
      "dest": "/servicios/traslados.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/signals/(.*)",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(e|n|n-2|o|t|t-2)\\.html",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/(.*)\\.html$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
